# Copy this file to .env and fill in the values. Never commit .env.

# All models run through OpenRouter (openrouter.ai). Set a credit limit on the key.
OPENROUTER_API_KEY=sk-or-...

# Strong model for damage assessment and fraud review, cheaper one for chat and photo checks
CLAUDE_MODEL=anthropic/claude-opus-5.5
CLAUDE_MODEL_FAST=anthropic/claude-haiku-4.5

# Damage assessment, chosen after the model comparison (batch test)
ASSESS_MODEL=moonshotai/kimi-k3

# Optional: to call Claude directly at Anthropic instead, add a key and use
# CLAUDE_MODEL=claude-opus-5-5 and CLAUDE_MODEL_FAST=claude-haiku-4-5
ANTHROPIC_API_KEY=

# Shared team password for the app
APP_PASSWORD=choose-a-team-password
